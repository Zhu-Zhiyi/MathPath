{
  "manifest_version": 3,
  "name": "MathPath · Canvas 回放伴学",
  "version": "0.4.0",
  "minimum_chrome_version": "124",
  "description": "在交大 Canvas / 课堂实录回放旁边，一键解析当前完整视频、同步笔记、提问并记录定理。",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "连接 MathPath"},
  "externally_connectable": {"matches": ["http://127.0.0.1/*"]},
  "content_scripts": [{
    "matches": ["https://oc.sjtu.edu.cn/*", "https://v.sjtu.edu.cn/*", "http://127.0.0.1/*"],
    "js": ["vendor/katex/katex.min.js", "vendor/katex/auto-render.min.js", "direct_video.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["panel.css", "vendor/katex/katex.min.css", "vendor/katex/fonts/*"],
    "matches": ["https://oc.sjtu.edu.cn/*", "https://v.sjtu.edu.cn/*", "http://127.0.0.1/*"]
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
